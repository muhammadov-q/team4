meta {
  name: Auth - sign up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-up
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "correct horse",
    "first_name": "Bruno",
    "last_name": "Tester"
  }
}

script:pre-request {
  // Unique per run, so reruns against the same database pass.
  bru.setVar("email", `bruno-${Date.now()}@example.com`);
}

assert {
  res.status: eq 201
  res.body.email: eq {{email}}
  res.body.first_name: eq Bruno
  res.headers['set-cookie']: isDefined
}
