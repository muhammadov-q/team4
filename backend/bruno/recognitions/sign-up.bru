meta {
  name: Recognitions - sign up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-up
  body: json
  auth: none
}

body:json {
  {
    "email": "{{historyEmail}}",
    "password": "correct horse"
  }
}

script:pre-request {
  bru.setVar("historyEmail", `bruno-history-${Date.now()}@example.com`);
}

assert {
  res.status: eq 201
}
