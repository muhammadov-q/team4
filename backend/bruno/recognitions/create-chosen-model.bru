meta {
  name: Recognitions - read with a chosen model
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/recognitions
  body: multipartForm
  auth: none
}

body:multipart-form {
  image: @file(fixtures/test.png)
  model: eparchos
}

assert {
  res.status: eq 201
  res.body.model_version: eq eparchos-6791
}
