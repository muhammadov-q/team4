meta {
  name: Predict - image
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/predict
  body: multipartForm
  auth: none
}

body:multipart-form {
  image: @file(fixtures/test.png)
}

assert {
  res.status: eq 200
  res.body.model_version: eq mock
  res.body.predictions: isArray
}

tests {
  const predictions = res.getBody().predictions;

  test("returns the dummy digits in order", function () {
    expect(predictions.map((p) => p.text)).to.eql(["2", "5", "0", "0", "0", "0"]);
  });

  test("each prediction has text, probabilities and box", function () {
    for (const p of predictions) {
      expect(p).to.have.all.keys("text", "probabilities", "box");
      expect(p.box).to.have.all.keys("x", "y", "w", "h");
    }
  });

  test("dummy is fully confident in each prediction", function () {
    for (const p of predictions) {
      expect(p.probabilities).to.eql({ [p.text]: 1.0 });
    }
  });
}
