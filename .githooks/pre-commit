#!/usr/bin/env bash
# Runs before every commit. If the commit touches frontend/, lint-staged checks
# only the staged frontend files: ESLint --fix on JS/TS, then Prettier on JS/TS,
# JSON, Markdown, CSS and YAML (rules in frontend/.lintstagedrc.json). An error
# it can't fix stops the commit. Python files aren't checked here yet.
# Skip once with: git commit --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

DIM=$'\033[2m'; YELLOW=$'\033[1;33m'; RESET=$'\033[0m'

if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '^frontend/'; then
    exit 0
fi

if [ ! -x frontend/node_modules/.bin/lint-staged ]; then
    echo "${YELLOW}pre-commit: frontend/node_modules is missing, skipping staged-file checks.${RESET}"
    echo "${DIM}Run 'npm install' in frontend/ to enable them.${RESET}"
    exit 0
fi

cd frontend
exec node_modules/.bin/lint-staged
