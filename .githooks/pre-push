#!/usr/bin/env bash
# Runs the check script of every area this push touches (<area>/check.sh, the same
# script CI runs). Pre-push rather than pre-commit: the suites take tens of seconds, and
# this is the last point where a break is still local. Enable with scripts/install-hooks.sh.

set -uo pipefail

# Areas gated here. One without a check.sh yet is skipped with a note, so the backend
# and mobile apps join by adding theirs.
AREAS=(frontend backend mobile)

ZERO='0000000000000000000000000000000000000000'
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[0;91m'; GREEN=$'\033[0;32m'; RESET=$'\033[0m'

changed=""
saw_ref=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue  # branch deletion
    saw_ref=1

    if [ "$remote_sha" != "$ZERO" ]; then
        base="$remote_sha"
    else
        # New branch: measure against the branch it will merge into.
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null)"
    fi

    # cat-file, not just non-empty: the remote sha can be an object we never fetched,
    # and a failed diff would leave `changed` empty and skip everything.
    if [ -n "$base" ] && git cat-file -e "${base}^{commit}" 2>/dev/null; then
        changed+="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"$'\n'
    else
        # No usable base: treat everything as changed. Fail safe, never fail open.
        changed+="$(git ls-tree -r --name-only "$local_sha" 2>/dev/null)"$'\n'
    fi
done

[ "$saw_ref" = "0" ] && exit 0

suites=()
for area in "${AREAS[@]}"; do
    grep -q "^$area/" <<<"$changed" || continue
    if [ -f "$area/check.sh" ]; then
        suites+=("$area")
    else
        echo "${DIM}pre-push: $area/ changed but has no check.sh yet, not gated${RESET}"
    fi
done

if [ ${#suites[@]} -eq 0 ]; then
    echo "${DIM}pre-push: no gated areas changed, skipping checks${RESET}"
    exit 0
fi

echo "${BOLD}pre-push${RESET} ${DIM}running checks for: ${suites[*]}${RESET}"
echo "${DIM}(bypass with git push --no-verify)${RESET}"

# A reinstall would dominate the runtime; CI leaves this unset and does install.
export CHECK_SKIP_INSTALL=1

failed=()
for suite in "${suites[@]}"; do
    # From its own directory: the check scripts refuse to run anywhere else.
    if ! ( cd "$suite" && bash check.sh ); then
        failed+=("$suite")
    fi
done

if [ ${#failed[@]} -gt 0 ]; then
    echo
    echo "${RED}${BOLD}pre-push: ${failed[*]} failed. Push aborted.${RESET}"
    echo "${DIM}Fix the above, or bypass deliberately with: git push --no-verify${RESET}"
    exit 1
fi

echo "${GREEN}${BOLD}pre-push: all checks passed${RESET}"
exit 0
